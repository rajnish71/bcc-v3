---
/**
 * activities/[id].astro
 * Dynamic Route: /activities/[id]/ -- [id] is the Activity slug (or numeric id).
 *
 * Activity detail view backed by the live Activity API (GET /api/v1/events/:idOrSlug).
 * Content is pre-rendered from the API at build time; the client script then
 * refreshes live values (capacity, state) and drives registration.
 *
 * Participation is by Registered User. Membership is never required by this
 * page itself -- the API applies the Activity's own eligibility rules.
 * KNOWN LIMITATION (Stage 2 follow-up): pages are statically generated, so an
 * Activity published after a build has no detail route until the next deploy.
 * There is no seed fallback; if the API is unreachable the page says so.
 *
 * Historical Activities show a date that is never more precise than what is
 * known, plus their provenance note, and are not open for registration.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import { BUILD_API_URL } from '../../lib/api';

export async function getStaticPaths() {
  let items: any[] = [];
  try {
    const res = await fetch(`${BUILD_API_URL}/events?limit=100`);
    if (res.ok) {
      const json = await res.json();
      items = Array.isArray(json.items) ? json.items : [];
    }
  } catch {
    // Backend unreachable at build time: no Activity pages are generated.
  }

  const paths: { params: { id: string }; props: { event: any } }[] = [];
  for (const it of items) {
    let event: any = null;
    try {
      const res = await fetch(`${BUILD_API_URL}/events/${it.slug}`);
      if (res.ok) event = await res.json();
    } catch {
      // fall through with null; client script hydrates from the API
    }
    if (it.slug) paths.push({ params: { id: it.slug }, props: { event } });
    if (it.id) paths.push({ params: { id: String(it.id) }, props: { event } });
  }
  return paths;
}

const { event } = Astro.props as { event: any };

const TYPE_LABEL: Record<string, string> = {
  PHOTOWALK: 'Photowalk', BIRD_WALK: 'Bird Walk', WORKSHOP: 'Workshop', SEMINAR: 'Seminar',
  TOUR: 'Tour', MEETUP: 'Meetup', TRAINING: 'Training', CONSERVATION: 'Conservation',
  EXHIBITION_EVENT: 'Exhibition', GOVERNANCE: 'Governance', AWARD_CEREMONY: 'Award Ceremony',
  ONLINE: 'Online', COLLABORATIVE: 'Collaborative', OTHER: 'Activity',
};
const DIFFICULTY_LABEL: Record<string, string> = {
  ALL: 'All levels', BEGINNER: 'Beginner-friendly', INTERMEDIATE: 'Intermediate', ADVANCED: 'Advanced',
};

// Public wording only: no constitutional class names (MEM-006).
function eligibilityLabel(mode: string | undefined): string {
  if (mode === 'OPEN') return 'Open to all registered users';
  if (mode === 'INVITE_ONLY') return 'By invitation';
  return 'Members only';
}

const title = event?.title ?? 'Activity';
const typeLabel = event ? (TYPE_LABEL[event.event_type] ?? 'Activity') : 'Activity';
const difficulty = event ? (DIFFICULTY_LABEL[event.difficulty_level] ?? '') : '';
const location = event?.location_name ?? '';
const description = event?.description ?? '';
const feeText = !event ? '—' : event.fee_type === 'FREE' ? 'Free' : `₹${(event.base_fee_paise / 100).toLocaleString('en-IN')}`;
const gear: string[] = (event?.what_to_bring ?? '').split(/[\n,]+/).map((x: string) => x.trim()).filter(Boolean);
const isHistorical = Boolean(event?.is_historical);
---

<BaseLayout
  title={title}
  description={description || `${typeLabel} — Bhopal Camera Club`}
>
  <!-- Event Page Hero -->
  <div class="event-hero surface-white">
    <div class="container">
      <div class="event-meta-top">
        <span id="event-tag" class="tag tag-photowalk">{typeLabel}</span>
        <span id="event-difficulty" class="event-difficulty-badge">{difficulty}</span>
      </div>
      <h1 id="event-title" class="event-title">{title}</h1>
      <p id="event-subtitle" class="event-subtitle-location">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <circle cx="6" cy="6" r="4" stroke="currentColor" stroke-width="1.5"/>
        </svg>
        <span id="event-location">{location}</span>
      </p>
    </div>
    <div class="hairline"></div>
  </div>

  <!-- Event Body Content -->
  <div class="container event-layout">
    <!-- Left Column: Details -->
    <main class="event-main">
      <SectionHeader eyebrow="Overview" title="Activity Details" align="left" />
      <div id="event-description" class="event-description-text">
        {description && <p>{description}</p>}
      </div>

      <div class="event-gear-checklist" id="event-gear-block" hidden={gear.length === 0}>
        <h3 class="checklist-title">What to Bring</h3>
        <ul id="event-gear-list" class="checklist-items">
          {gear.map((item: string) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      <div class="event-provenance" id="event-provenance" hidden={!(isHistorical && event?.historical_source_note)}>
        <strong>Source.</strong> <span id="event-provenance-text">{event?.historical_source_note ?? ''}</span>
      </div>

      <!-- Activity Gallery: Canonical Photos linked via photos.source_event_id.
           Populated client-side from GET /api/v1/gallery/events/:id/photos. -->
      <section class="event-gallery" id="event-gallery" aria-label="Activity Gallery" hidden>
        <SectionHeader eyebrow="Photographs" title="Activity Gallery" align="left" />
        <div id="event-gallery-grid" class="event-gallery__grid"></div>
      </section>
    </main>

    <!-- Right Column: Registration Card -->
    <aside class="event-sidebar">
      <div class="sticky-sidebar">
        <div class="reg-card">
          <div class="reg-card__header" id="reg-fee-block" hidden={isHistorical}>
            <span class="reg-card__label">Participation Fee</span>
            <span id="event-price" class="reg-card__price">{feeText}</span>
          </div>

          <div class="reg-card__body">
            <div class="reg-card__spec">
              <span class="spec-label">When</span>
              <span id="event-time" class="spec-value">—</span>
            </div>
            <div class="reg-card__spec" id="spec-eligibility" hidden={isHistorical}>
              <span class="spec-label">Eligibility</span>
              <span id="event-eligibility" class="spec-value tag tag-exhibition">{event ? eligibilityLabel(event.eligibility_mode) : '—'}</span>
            </div>
            <div class="reg-card__spec" id="spec-spots" hidden={isHistorical}>
              <span class="spec-label">Availability</span>
              <span id="event-spots" class="spec-value">—</span>
            </div>
          </div>

          <div class="reg-card__footer">
            <button id="register-btn" class="btn btn-dark btn-md reg-btn" disabled>
              Loading…
            </button>
            <p id="reg-status-sub" class="reg-sub-label"></p>
          </div>
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
.event-hero {
  padding-top: calc(var(--nav-h) + var(--s-8));
  padding-bottom: var(--s-6);
}
.event-meta-top {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  margin-bottom: var(--s-3);
}
.event-difficulty-badge {
  font-family: var(--font-body);
  font-size: 11px;
  color: var(--ink-400);
}
.event-title {
  font-family: var(--font-display);
  font-size: clamp(32px, 5vw, 48px);
  font-weight: 700;
  color: var(--ink-900);
  line-height: 1.15;
  letter-spacing: -0.025em;
  margin-bottom: var(--s-3);
}
.event-subtitle-location {
  font-family: var(--font-body);
  font-size: 14px;
  color: var(--ink-600);
  display: flex;
  align-items: center;
  gap: var(--s-1);
}

/* Layout */
.event-layout {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: var(--s-8);
  padding-top: var(--s-8);
  padding-bottom: var(--s-12);
}

.event-main {
  display: flex;
  flex-direction: column;
  gap: var(--s-6);
}
.event-description-text {
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.75;
  color: var(--ink-600);
}
.event-gear-checklist {
  border-top: 1px solid var(--hairline);
  padding-top: var(--s-6);
  margin-top: var(--s-2);
}
.checklist-title {
  font-family: var(--font-display);
  font-size: 18px;
  font-weight: 700;
  color: var(--ink-900);
  margin-bottom: var(--s-3);
}
.checklist-items {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
}
.checklist-items li {
  font-family: var(--font-body);
  font-size: 14px;
  color: var(--ink-600);
  padding-left: 20px;
  position: relative;
}
.checklist-items li::before {
  content: "✓";
  position: absolute;
  left: 0;
  color: var(--gold-600);
  font-weight: 600;
}

/* Sidebar & Registration Card */
.event-sidebar {
  position: relative;
}
.sticky-sidebar {
  position: sticky;
  top: calc(var(--nav-h) + var(--s-4));
}
.reg-card {
  background: var(--surface-0);
  border: 1px solid var(--hairline);
  box-shadow: var(--e-1);
}
.reg-card__header {
  padding: var(--s-4);
  border-bottom: 1px solid var(--hairline-soft);
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.reg-card__label {
  font-family: var(--font-body);
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--ink-400);
}
.reg-card__price {
  font-family: var(--font-display);
  font-size: 28px;
  font-weight: 700;
  color: var(--gold-600);
}
.reg-card__body {
  padding: var(--s-4);
  display: flex;
  flex-direction: column;
  gap: var(--s-3);
}
.reg-card__spec {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: var(--font-body);
  font-size: 13px;
}
.spec-label {
  color: var(--ink-400);
}
.spec-value {
  color: var(--ink-900);
  font-weight: 500;
}
.reg-card__footer {
  padding: var(--s-4);
  border-top: 1px solid var(--hairline-soft);
  background: var(--surface-1);
}
.reg-btn {
  width: 100%;
  justify-content: center;
  margin-bottom: var(--s-2);
}
.reg-sub-label {
  font-family: var(--font-body);
  font-size: 11px;
  color: var(--ink-400);
  text-align: center;
}

@media (max-width: 900px) {
  .event-layout {
    grid-template-columns: 1fr;
    gap: var(--s-6);
  }
  .sticky-sidebar {
    position: static;
  }
}
.event-provenance {
  border-top: 1px solid var(--hairline);
  padding-top: var(--s-4);
  font-family: var(--font-body);
  font-size: 13px;
  color: var(--ink-400);
  line-height: 1.6;
}
.event-provenance strong { color: var(--ink-600); font-weight: 600; }
.reg-btn[hidden], .reg-card__spec[hidden] { display: none; }

.event-gallery { border-top: 1px solid var(--hairline); padding-top: var(--s-6); }
.event-gallery[hidden] { display: none; }
/* Gallery tiles are created at runtime, so they never receive Astro's scoping
   attribute — style them through :global. Photos are never rounded. */
.event-gallery__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: var(--s-3);
}
:global(.event-gallery__grid.is-single) { grid-template-columns: minmax(0, 560px); }
:global(.event-photo) { display: block; margin: 0; background: var(--surface-1); text-decoration: none; }
:global(.event-photo img) { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 0; }
:global(.event-photo figcaption) {
  font-family: var(--font-body);
  font-size: 12px;
  color: var(--ink-600);
  padding: var(--s-2) 0;
  line-height: 1.4;
}
</style>

<script>
  // Refreshes live values from the Activity API and drives registration.
  // Registration requires a signed-in Registered User; membership is enforced
  // server-side only when the Activity's eligibility rules require it.
  const slug = window.location.pathname.split('/').filter(Boolean).pop();

  const TYPE_LABEL: Record<string, string> = {
    PHOTOWALK: 'Photowalk', BIRD_WALK: 'Bird Walk', WORKSHOP: 'Workshop', SEMINAR: 'Seminar',
    TOUR: 'Tour', MEETUP: 'Meetup', TRAINING: 'Training', CONSERVATION: 'Conservation',
    EXHIBITION_EVENT: 'Exhibition', GOVERNANCE: 'Governance', AWARD_CEREMONY: 'Award Ceremony',
    ONLINE: 'Online', COLLABORATIVE: 'Collaborative', OTHER: 'Activity',
  };

  const $ = (id: string) => document.getElementById(id)!;
  const token = () => localStorage.getItem('bcc_token');

  function eligibilityLabel(mode: string): string {
    if (mode === 'OPEN') return 'Open to all registered users';
    if (mode === 'INVITE_ONLY') return 'By invitation';
    return 'Members only';
  }

  // Never more precise than what is recorded.
  function whenText(ev: any): string {
    if (ev.starts_at) {
      return new Date(ev.starts_at).toLocaleString('en-IN', {
        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit',
      });
    }
    let t = 'Date not recorded';
    if (ev.historical_year != null) {
      t = ev.historical_month != null
        ? new Date(ev.historical_year, ev.historical_month - 1, 1).toLocaleString('en-IN', { month: 'long', year: 'numeric' })
        : String(ev.historical_year);
    }
    return ev.historical_date_note ? `${ev.historical_date_note} (${t})` : t;
  }

  function setRegistration(ev: any) {
    const btn = $('register-btn') as HTMLButtonElement;
    const sub = $('reg-status-sub');
    const fresh = btn.cloneNode(false) as HTMLButtonElement; // drop stale listeners
    btn.replaceWith(fresh);
    const b = fresh;
    b.id = 'register-btn';
    b.className = 'btn btn-dark btn-md reg-btn';
    sub.textContent = '';

    if (ev.is_historical || ev.state === 'COMPLETED') {
      b.hidden = true;
      sub.textContent = ev.is_historical ? 'This is a record of a past BCC activity.' : 'This activity has taken place.';
      return;
    }
    if (ev.state === 'CANCELLED') {
      b.textContent = 'Cancelled';
      b.disabled = true;
      sub.textContent = ev.cancellation_reason || 'This activity has been cancelled.';
      return;
    }
    if (ev.fee_type !== 'FREE') {
      b.textContent = 'Paid registration coming soon';
      b.disabled = true;
      sub.textContent = 'Online payment for activities is not available yet.';
      return;
    }
    const full = ev.capacity != null && ev.registration_count >= ev.capacity;
    if (full && !ev.waitlist_enabled) {
      b.textContent = 'Full';
      b.disabled = true;
      sub.textContent = 'No places remaining for this activity.';
      return;
    }

    b.disabled = false;
    b.textContent = full ? 'Join waitlist' : 'Register';
    if (!token()) {
      sub.innerHTML = '';
      const a = document.createElement('a');
      a.href = `/auth/signin/?redirect=${encodeURIComponent(window.location.pathname)}`;
      a.textContent = 'Sign in';
      a.style.cssText = 'color:var(--gold-600);text-decoration:underline;';
      sub.append(a, ' with your BCC account to register.');
    }

    b.addEventListener('click', async () => {
      if (!token()) {
        window.location.href = `/auth/signin/?redirect=${encodeURIComponent(window.location.pathname)}`;
        return;
      }
      b.disabled = true;
      try {
        const res = await fetch(`/api/v1/events/${ev.id}/registrations`, {
          method: 'POST',
          headers: { Authorization: `Bearer ${token()}` },
        });
        const body = await res.json().catch(() => ({}));
        if (res.status === 201) {
          b.textContent = body.status === 'WAITLISTED' ? 'On the waitlist' : 'Registered';
          sub.textContent = body.status === 'WAITLISTED'
            ? `You are number ${body.waitlist_position} on the waitlist.`
            : 'You are registered. A confirmation is on its way.';
        } else if (res.status === 401) {
          window.location.href = `/auth/signin/?redirect=${encodeURIComponent(window.location.pathname)}`;
        } else {
          sub.textContent = body.message || 'Registration could not be completed.';
          b.disabled = res.status !== 409 ? false : true;
          if (res.status === 409) b.textContent = 'Already registered';
        }
      } catch {
        sub.textContent = 'Network error. Please try again.';
        b.disabled = false;
      }
    });
  }

  function render(ev: any) {
    $('event-title').textContent = ev.title;
    document.title = `${ev.title} | Bhopal Camera Club`;
    $('event-location').textContent = ev.location_name ?? '';
    $('event-tag').textContent = TYPE_LABEL[ev.event_type] ?? 'Activity';
    $('event-time').textContent = whenText(ev);
    $('event-description').replaceChildren();
    if (ev.description) {
      const p = document.createElement('p');
      p.textContent = ev.description;
      $('event-description').append(p);
    }

    const historical = Boolean(ev.is_historical);
    $('reg-fee-block').hidden = historical;
    $('spec-eligibility').hidden = historical;
    $('spec-spots').hidden = historical;
    $('event-price').textContent = ev.fee_type === 'FREE' ? 'Free' : `₹${(ev.base_fee_paise / 100).toLocaleString('en-IN')}`;
    $('event-eligibility').textContent = eligibilityLabel(ev.eligibility_mode);
    $('event-spots').textContent = ev.capacity == null
      ? 'Open attendance'
      : `${Math.max(ev.capacity - ev.registration_count, 0)} of ${ev.capacity} places left`;

    const gear = String(ev.what_to_bring ?? '').split(/[\n,]+/).map((x: string) => x.trim()).filter(Boolean);
    const gearList = $('event-gear-list');
    gearList.replaceChildren(...gear.map((g: string) => {
      const li = document.createElement('li');
      li.textContent = g;
      return li;
    }));
    $('event-gear-block').hidden = gear.length === 0;

    $('event-provenance').hidden = !(historical && ev.historical_source_note);
    $('event-provenance-text').textContent = ev.historical_source_note ?? '';

    setRegistration(ev);
  }

  // Activity Gallery: Canonical Photos linked to this Activity. Hidden when the
  // Activity has none (or the API is unavailable) -- no placeholders, no banner.
  async function loadGallery(eventId: number) {
    const section = $('event-gallery');
    const grid = $('event-gallery-grid');
    try {
      const res = await fetch(`/api/v1/gallery/events/${eventId}/photos`);
      if (!res.ok) throw new Error(`Gallery API ${res.status}`);
      const { photos } = await res.json() as { photos: any[] };
      if (!Array.isArray(photos) || photos.length === 0) {
        section.hidden = true;
        return;
      }
      grid.classList.toggle('is-single', photos.length === 1);
      grid.replaceChildren(...photos.map((p: any) => {
        const fig = document.createElement('figure');
        fig.className = 'event-photo';
        const a = document.createElement('a');
        a.href = `/showcase/${p.id}/`;
        const img = document.createElement('img');
        img.src = p.urls?.medium ?? p.urls?.thumbnail;
        img.loading = 'lazy';
        img.alt = p.title || p.caption || 'Activity photograph';
        a.append(img);
        fig.append(a);
        const credit = [p.title, p.photographer?.name].filter(Boolean).join(' — ');
        if (credit) {
          const cap = document.createElement('figcaption');
          cap.textContent = credit;
          fig.append(cap);
        }
        return fig;
      }));
      section.hidden = false;
    } catch {
      section.hidden = true;
    }
  }

  async function load() {
    if (!slug) return;
    try {
      const res = await fetch(`/api/v1/events/${encodeURIComponent(slug)}`);
      if (!res.ok) throw new Error(`Activities API ${res.status}`);
      const ev = await res.json();
      render(ev);
      void loadGallery(ev.id);
    } catch {
      const btn = $('register-btn') as HTMLButtonElement;
      btn.textContent = 'Unavailable';
      btn.disabled = true;
      $('reg-status-sub').textContent = 'Live details are temporarily unavailable. Please try again shortly.';
    }
  }

  load();
</script>
