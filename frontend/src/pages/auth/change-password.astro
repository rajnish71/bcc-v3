---
/**
 * auth/change-password.astro
 * Route: /auth/change-password/
 *
 * Mandatory password-change step for accounts with force_password_reset = TRUE
 * (e.g. after an administrator password reset). The user has already
 * authenticated; their session is restricted by the API until the flag is
 * cleared. Identity/authentication concern, so it lives under /auth/ and not
 * inside HubLayout (IDENTITY-ARCH-001, same placement as identity-complete).
 *
 * Reuses the canonical password-change endpoint
 *   PUT /api/v1/hub/account-settings/password   { currentPassword, newPassword }
 * which updates the hash, clears force_password_reset and writes the
 * PASSWORD_CHANGED audit event in one transaction.
 *
 * Preserves a safe ?next= destination and returns the user there afterwards.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthCard from '../../components/auth/AuthCard.astro';
import Banner from '../../components/ui/Banner.astro';
import FormField from '../../components/forms/FormField.astro';
---

<BaseLayout
  title="Change Password"
  description="Choose a new password to continue to your Bhopal Camera Club account."
  bodyClass="auth-page"
>
  <AuthCard label="Change password">
    <h1 class="auth-heading">Choose a new password</h1>
    <p class="auth-sub">
      Your password was reset by an administrator. Enter the temporary password you
      just signed in with, then choose a new one to continue.
    </p>

    <Banner id="cp-error" variant="error" />

    <FormField id="current-password" label="Temporary password">
      <input id="current-password" type="password" class="pw-input" autocomplete="current-password" required />
    </FormField>

    <FormField id="new-password" label="New password">
      <input id="new-password" type="password" class="pw-input" placeholder="At least 8 characters" autocomplete="new-password" required />
    </FormField>

    <FormField id="confirm-password" label="Confirm new password">
      <input id="confirm-password" type="password" class="pw-input" placeholder="Repeat your new password" autocomplete="new-password" required />
    </FormField>

    <button id="cp-btn" type="button" class="btn btn-dark btn-lg auth-btn">Change Password</button>
    <button id="cp-logout" type="button" class="cp-logout">Sign out</button>
  </AuthCard>
</BaseLayout>

<style>
.pw-input {
  height: 44px;
  padding: 0 12px;
  border: 1.5px solid var(--hairline-strong);
  border-radius: var(--input-radius);
  background: var(--input-bg);
  color: var(--input-text);
  font-size: 14px;
  font-family: var(--font-body);
  width: 100%;
  box-sizing: border-box;
}
.pw-input:focus {
  outline: none;
  border-color: var(--input-border-focus);
  box-shadow: 0 0 0 3px rgba(168, 132, 60, 0.12);
}
.pw-input::placeholder { color: var(--input-placeholder); }
.pw-input.is-error { border-color: var(--input-error); }
.cp-logout {
  display: block;
  margin: var(--s-3) auto 0;
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  color: var(--ink-600);
  font-family: var(--font-body);
  font-size: 13px;
  text-decoration: underline;
}
</style>

<script>
  const API = '/api/v1';

  const errorBanner = document.getElementById('cp-error') as HTMLElement;
  const currentEl   = document.getElementById('current-password') as HTMLInputElement;
  const newEl       = document.getElementById('new-password') as HTMLInputElement;
  const confirmEl   = document.getElementById('confirm-password') as HTMLInputElement;
  const btn         = document.getElementById('cp-btn') as HTMLButtonElement;

  function getRedirectTarget(): string {
    const next = new URLSearchParams(window.location.search).get('next');
    if (next && next.startsWith('/') && !next.startsWith('//') && !next.includes('\\')) return next;
    return '/hub/';
  }

  function clearAuth(): void {
    localStorage.removeItem('bcc_token');
    localStorage.removeItem('bcc_refresh');
    localStorage.removeItem('bcc_user');
  }

  function toSignin(): void {
    const next = encodeURIComponent(getRedirectTarget());
    window.location.replace(`/auth/signin/?next=${next}`);
  }

  function showError(msg: string): void {
    errorBanner.textContent = msg;
    errorBanner.hidden = false;
  }
  function hideError(): void {
    errorBanner.hidden = true;
    [currentEl, newEl, confirmEl].forEach(el => el?.classList.remove('is-error'));
  }

  /** Rotate the token pair; the server re-reads force_password_reset. */
  async function refreshSession(): Promise<boolean> {
    const refresh = localStorage.getItem('bcc_refresh');
    if (!refresh) return false;
    try {
      const res = await fetch(`${API}/auth/refresh`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ refreshToken: refresh }),
      });
      if (!res.ok) return false;
      const data = await res.json() as { accessToken: string; refreshToken: string };
      localStorage.setItem('bcc_token', data.accessToken);
      localStorage.setItem('bcc_refresh', data.refreshToken);
      return true;
    } catch {
      return false;
    }
  }

  async function putPassword(currentPassword: string, newPassword: string): Promise<Response> {
    return fetch(`${API}/hub/account-settings/password`, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${localStorage.getItem('bcc_token') ?? ''}`,
      },
      body: JSON.stringify({ currentPassword, newPassword }),
    });
  }

  /* -- Guard: needs a session; if no change is pending, move on --------- */
  async function init(): Promise<void> {
    if (!localStorage.getItem('bcc_token')) { toSignin(); return; }
    try {
      let res = await fetch(`${API}/users/me`, {
        headers: { Authorization: `Bearer ${localStorage.getItem('bcc_token')}` },
      });
      if (res.status === 401 && await refreshSession()) {
        res = await fetch(`${API}/users/me`, {
          headers: { Authorization: `Bearer ${localStorage.getItem('bcc_token')}` },
        });
      }
      if (!res.ok) { clearAuth(); toSignin(); return; }
      const me = await res.json() as { forcePasswordReset?: boolean };
      if (!me.forcePasswordReset) window.location.replace(getRedirectTarget());
    } catch { /* network issue: leave the form usable */ }
  }

  async function submit(): Promise<void> {
    hideError();
    const currentPw = currentEl.value;
    const newPw     = newEl.value;
    const confirmPw = confirmEl.value;

    if (!currentPw) { showError('Enter the temporary password you signed in with.'); currentEl.classList.add('is-error'); return; }
    if (newPw.length < 8) { showError('Password must be at least 8 characters.'); newEl.classList.add('is-error'); return; }
    if (newPw !== confirmPw) { showError('Passwords do not match.'); confirmEl.classList.add('is-error'); return; }

    btn.disabled = true;
    btn.textContent = 'Updating...';

    try {
      let res = await putPassword(currentPw, newPw);
      // Access token (15 min) may have lapsed while the form was open.
      if (res.status === 401 && await refreshSession()) res = await putPassword(currentPw, newPw);

      if (res.ok) {
        // Flag is now cleared: rotate to an unrestricted token pair.
        if (await refreshSession()) {
          window.location.replace(getRedirectTarget());
        } else {
          clearAuth();
          toSignin();
        }
        return;
      }

      const body = await res.json().catch(() => ({})) as { message?: string | string[] };
      const msg = Array.isArray(body.message) ? body.message.join(' ') : body.message;
      showError(typeof msg === 'string' && msg ? msg : 'Something went wrong. Please try again.');
    } catch {
      showError('A network error occurred. Please check your connection and try again.');
    }

    btn.disabled = false;
    btn.textContent = 'Change Password';
  }

  btn?.addEventListener('click', submit);
  [currentEl, newEl, confirmEl].forEach(el =>
    el?.addEventListener('keydown', (e: KeyboardEvent) => { if (e.key === 'Enter') submit(); }),
  );

  document.getElementById('cp-logout')?.addEventListener('click', async () => {
    const refresh = localStorage.getItem('bcc_refresh');
    if (refresh) {
      await fetch(`${API}/auth/logout`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ refreshToken: refresh }),
      }).catch(() => undefined);
    }
    clearAuth();
    window.location.replace('/auth/signin/');
  });

  init();
</script>
