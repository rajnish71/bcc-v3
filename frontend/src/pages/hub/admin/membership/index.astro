---
/**
 * hub/admin/membership/index.astro — Membership Admin Console
 * Route: /hub/admin/membership/
 *
 * Sections:
 *   1. Dashboard stats (counts by state & class, expiring count)
 *   2. Membership classes + configurable entitlements
 *   3. Senior status eligible members + batch assign
 *   4. Members expiring soon
 *   5. Recent lifecycle audit events
 *   6. Notification types catalogue
 */
import HubLayout from '../../../../layouts/HubLayout.astro';
---

<HubLayout title="Membership Admin" description="MEM-008 membership management console.">

  <div class="mem-admin">

    <!-- ① DASHBOARD STATS ──────────────────────────────────────────────────── -->
    <section class="admin-section" id="section-stats">
      <div class="section-kicker"><span class="kicker-rule"></span>Membership Admin</div>
      <h2 class="section-title">Membership Dashboard</h2>

      <div id="stats-loading" class="state-loading">Loading statistics…</div>
      <div id="stats-error"   class="state-error"   hidden></div>

      <div id="stats-grid" class="stats-grid" hidden>
        <!-- Populated by JS -->
      </div>

      <div id="state-breakdown" class="breakdown-row" hidden></div>
      <div id="class-breakdown" class="breakdown-row" hidden></div>
    </section>

    <!-- ② MEMBERSHIP CLASSES & ENTITLEMENTS ─────────────────────────────────── -->
    <section class="admin-section" id="section-classes">
      <div class="section-kicker"><span class="kicker-rule"></span>Configuration</div>
      <h2 class="section-title">Membership Classes &amp; Entitlements</h2>
      <p class="section-hint">All benefit values are configurable without code changes via the entitlement engine (MEM-006). Use the Entitlements API to modify individual keys.</p>

      <div id="classes-loading" class="state-loading">Loading classes…</div>
      <div id="classes-error"   class="state-error"   hidden></div>

      <div id="classes-list" class="classes-list" hidden></div>
    </section>

    <!-- ③ SENIOR STATUS ─────────────────────────────────────────────────────── -->
    <section class="admin-section" id="section-senior">
      <div class="section-kicker"><span class="kicker-rule"></span>Recognition Management</div>
      <h2 class="section-title">Senior Member Eligibility</h2>
      <p class="section-hint">
        Auto-calculated per MEM-008: age ≥ 60 <strong>OR</strong> (age ≥ 50 &amp; tenure ≥ 5 yr) <strong>OR</strong> tenure ≥ 10 yr.
        Members already holding SENIOR_MEMBER recognition are excluded.
      </p>

      <div class="senior-actions-bar">
        <button type="button" id="btn-check-senior" class="btn-action">Check Eligibility</button>
        <button type="button" id="btn-assign-senior" class="btn-action btn-action--gold" hidden>
          Assign Senior Status to All Eligible
        </button>
      </div>

      <div id="senior-loading" class="state-loading" hidden>Evaluating…</div>
      <div id="senior-empty"   class="state-empty"   hidden>No eligible members found.</div>
      <div id="senior-error"   class="state-error"   hidden></div>
      <div id="senior-feedback" class="assign-feedback" hidden></div>

      <div id="senior-list" class="data-table-wrap" hidden></div>
    </section>

    <!-- ④ EXPIRING SOON ─────────────────────────────────────────────────────── -->
    <section class="admin-section" id="section-expiring">
      <div class="section-kicker"><span class="kicker-rule"></span>Renewals</div>
      <h2 class="section-title">Expiring Within 30 Days</h2>

      <div id="expiring-loading" class="state-loading">Loading…</div>
      <div id="expiring-empty"   class="state-empty"   hidden>No memberships expiring within 30 days.</div>
      <div id="expiring-error"   class="state-error"   hidden></div>
      <div id="expiring-list"    class="data-table-wrap" hidden></div>
    </section>

    <!-- ⑤ RECENT LIFECYCLE EVENTS ──────────────────────────────────────────── -->
    <section class="admin-section" id="section-events">
      <div class="section-kicker"><span class="kicker-rule"></span>Audit Trail</div>
      <h2 class="section-title">Recent Lifecycle Events</h2>

      <div id="events-loading" class="state-loading">Loading events…</div>
      <div id="events-empty"   class="state-empty"   hidden>No events recorded.</div>
      <div id="events-error"   class="state-error"   hidden></div>
      <div id="events-list"    class="data-table-wrap" hidden></div>
    </section>

    <!-- ⑥ NOTIFICATION TYPES ─────────────────────────────────────────────────── -->
    <section class="admin-section" id="section-notifs">
      <div class="section-kicker"><span class="kicker-rule"></span>Email Automation</div>
      <h2 class="section-title">Notification Types</h2>
      <p class="section-hint">Membership and renewal notification catalogue. Email templates are managed via the notification_templates table.</p>

      <div id="notifs-loading" class="state-loading">Loading notification types…</div>
      <div id="notifs-empty"   class="state-empty"   hidden>No notification types found.</div>
      <div id="notifs-error"   class="state-error"   hidden></div>
      <div id="notifs-list"    class="data-table-wrap" hidden></div>
    </section>

    <!-- 7: RENEWAL REMINDERS -->
    <section class="admin-section" id="section-reminders">
      <div class="section-kicker"><span class="kicker-rule"></span>Email Automation</div>
      <h2 class="section-title">Renewal Reminders</h2>
      <p class="section-hint">
        Dispatches RENEWAL_REMINDER_30/_15/_7/_1 notifications to members expiring within
        that many days. A 2-day dedup window prevents duplicate sends. Safe to run daily.
      </p>

      <div class="senior-actions-bar">
        <button type="button" id="btn-send-reminders" class="btn-action">Dispatch Renewal Reminders</button>
      </div>

      <div id="reminders-loading"  class="state-loading"   hidden>Dispatching...</div>
      <div id="reminders-error"    class="state-error"     hidden></div>
      <div id="reminders-feedback" class="assign-feedback" hidden></div>
    </section>

    <!-- 8: EXPIRY PROCESSING -->
    <section class="admin-section" id="section-expiry">
      <div class="section-kicker"><span class="kicker-rule"></span>Lifecycle Management</div>
      <h2 class="section-title">Expiry Processing</h2>
      <p class="section-hint">
        Marks overdue ACTIVE memberships as EXPIRED. Load the list to review before processing.
      </p>

      <div class="senior-actions-bar">
        <button type="button" id="btn-load-due" class="btn-action">Load Overdue Memberships</button>
        <button type="button" id="btn-process-expiry" class="btn-action btn-action--gold" hidden>Process All Expired</button>
      </div>

      <div id="expiry-loading"  class="state-loading"   hidden>Loading...</div>
      <div id="expiry-empty"    class="state-empty"     hidden>No overdue memberships found.</div>
      <div id="expiry-error"    class="state-error"     hidden></div>
      <div id="expiry-feedback" class="assign-feedback" hidden></div>
      <div id="expiry-list"     class="data-table-wrap" hidden></div>
    </section>

    <!-- 9: LEGACY STATUS ASSIGNMENT -->
    <section class="admin-section" id="section-legacy">
      <div class="section-kicker"><span class="kicker-rule"></span>Class Management</div>
      <h2 class="section-title">Assign Legacy Status</h2>
      <p class="section-hint">
        Grandfathers an existing member into LEGACY_MEMBER class. LEGACY_MEMBER is a closed
        class -- this admin pathway is the only route in.
      </p>

      <div class="member-search-box">
        <input type="text" id="legacy-search-input" class="member-search-input"
               placeholder="Search member by name or username..." autocomplete="off" />
      </div>
      <div id="legacy-search-results" class="search-results-list" hidden></div>

      <div id="legacy-member-card" class="selected-member-card" hidden>
        <div id="legacy-member-info"     class="selected-member-info"></div>
        <div id="legacy-membership-info" class="selected-membership-info"></div>
        <div class="assign-form-row">
          <input type="text" id="legacy-reason" class="member-search-input"
                 placeholder="Reason for legacy status assignment..." />
          <button type="button" id="btn-assign-legacy" class="btn-action btn-action--gold">Assign Legacy Status</button>
        </div>
      </div>

      <div id="legacy-error"    class="state-error"     hidden></div>
      <div id="legacy-feedback" class="assign-feedback" hidden></div>
    </section>

    <!-- 10: HONORARY RECOGNITION ASSIGNMENT -->
    <section class="admin-section" id="section-recog">
      <div class="section-kicker"><span class="kicker-rule"></span>Recognition Management</div>
      <h2 class="section-title">Assign Honorary Recognition</h2>
      <p class="section-hint">
        Assigns an honorary recognition to a member's active membership. Activates recognition
        modifiers granting Legacy-equivalent entitlements per MEM-008.
      </p>

      <div class="member-search-box">
        <input type="text" id="recog-search-input" class="member-search-input"
               placeholder="Search member by name or username..." autocomplete="off" />
      </div>
      <div id="recog-search-results" class="search-results-list" hidden></div>

      <div id="recog-member-card" class="selected-member-card" hidden>
        <div id="recog-member-info"     class="selected-member-info"></div>
        <div id="recog-membership-info" class="selected-membership-info"></div>
        <div class="assign-form-col">
          <label class="form-label">Recognition</label>
          <select id="recog-code-select" class="recog-select">
            <option value="HONORARY_MEMBER">HONORARY_MEMBER -- Legacy Benefits + Honorary Recognition</option>
            <option value="HONORARY_MENTOR">HONORARY_MENTOR -- Legacy Benefits + Honorary Mentor Recognition</option>
            <option value="HONORARY_GRANDMASTER">HONORARY_GRANDMASTER -- Legacy Benefits + Grandmaster Recognition</option>
            <option value="HONORARY_SENIOR_MEMBER">HONORARY_SENIOR_MEMBER -- Senior Member Badge + Recognition</option>
          </select>
        </div>
        <div class="assign-form-col">
          <label class="form-label">Reason</label>
          <input type="text" id="recog-reason" class="member-search-input"
                 placeholder="Reason for honorary recognition..." />
        </div>
        <div class="assign-form-row">
          <button type="button" id="btn-assign-recog" class="btn-action btn-action--gold">Assign Recognition</button>
        </div>
      </div>

      <div id="recog-error"    class="state-error"     hidden></div>
      <div id="recog-feedback" class="assign-feedback" hidden></div>
    </section>

  </div>

</HubLayout>

<style>
/* ── Layout ───────────────────────────────────────────────────────── */
.mem-admin {
  padding: 32px 0 80px;
  display: flex;
  flex-direction: column;
  gap: 56px;
}

/* ── Section ──────────────────────────────────────────────────────── */
.admin-section {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.section-kicker {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-body);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--gold-600);
}
.kicker-rule {
  display: inline-block;
  width: 24px;
  height: 1px;
  background: var(--gold-600);
}
.section-title {
  font-family: var(--font-display);
  font-size: 22px;
  font-weight: 600;
  color: var(--ink-900);
  margin: 0;
  line-height: 1.3;
}
.section-hint {
  font-family: var(--font-body);
  font-size: 13px;
  color: var(--ink-400);
  margin: 0;
  line-height: 1.6;
}

/* ── State messages ───────────────────────────────────────────────── */
.state-loading, .state-empty {
  font-family: var(--font-body);
  font-size: 13px;
  color: var(--ink-400);
  padding: 12px 0;
}
.state-error {
  font-family: var(--font-body);
  font-size: 13px;
  color: var(--input-error, #b91c1c);
  padding: 12px 0;
}

/* ── Stats grid ───────────────────────────────────────────────────── */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 12px;
}
.stat-card {
  background: var(--surface-0);
  border: 1px solid var(--hairline);
  padding: 16px 20px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.stat-card__value {
  font-family: var(--font-mono);
  font-size: 28px;
  font-weight: 700;
  color: var(--ink-900);
  line-height: 1;
}
.stat-card__value--gold { color: var(--gold-600); }
.stat-card__value--warn { color: #b45309; }
.stat-card__label {
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink-400);
}
.breakdown-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 4px;
}
.breakdown-pill {
  font-family: var(--font-body);
  font-size: 12px;
  color: var(--ink-600);
  background: var(--surface-2);
  border: 1px solid var(--hairline);
  padding: 4px 10px;
  white-space: nowrap;
}
.breakdown-pill strong {
  font-family: var(--font-mono);
  font-size: 13px;
  color: var(--ink-900);
}

/* ── Classes list ─────────────────────────────────────────────────── */
.classes-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.class-card {
  background: var(--surface-0);
  border: 1px solid var(--hairline);
  padding: 16px 20px;
}
.class-card__header {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 12px;
}
.class-card__name {
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 700;
  color: var(--ink-900);
}
.class-badge {
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 600;
  padding: 2px 7px;
  border: 1px solid;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.class-badge--operational { border-color: #0891b2; color: #0891b2; }
.class-badge--constitutional { border-color: var(--gold-600); color: var(--gold-600); }
.class-badge--recognition { border-color: #7c3aed; color: #7c3aed; }
.class-badge--status { border-color: #059669; color: #059669; }
.class-badge--closed { border-color: var(--ink-300); color: var(--ink-300); background: var(--surface-2); }
.class-card__entitlements {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 4px 12px;
}
.entitlement-row {
  display: flex;
  justify-content: space-between;
  font-family: var(--font-body);
  font-size: 12px;
  color: var(--ink-600);
  padding: 3px 0;
  border-bottom: 1px solid var(--hairline);
}
.entitlement-row__key {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--ink-500);
}
.entitlement-row__value {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--ink-900);
  font-weight: 600;
}
.no-entitlements {
  font-family: var(--font-body);
  font-size: 12px;
  color: var(--ink-300);
  font-style: italic;
}

/* ── Senior actions bar ───────────────────────────────────────────── */
.senior-actions-bar {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  align-items: center;
}
.btn-action {
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 600;
  padding: 9px 20px;
  border: 1px solid var(--hairline);
  background: var(--surface-0);
  color: var(--ink-800);
  cursor: pointer;
  transition: background 0.15s;
}
.btn-action:hover { background: var(--surface-2); }
.btn-action--gold {
  background: var(--gold-600);
  color: var(--surface-0);
  border-color: var(--gold-600);
}
.btn-action--gold:hover { opacity: 0.87; background: var(--gold-600); }
.btn-action:disabled { opacity: 0.45; cursor: not-allowed; }
.assign-feedback {
  font-family: var(--font-body);
  font-size: 13px;
  padding: 10px 14px;
  border: 1px solid var(--hairline);
  background: var(--surface-2);
  color: var(--ink-700);
}

/* ── Data tables ──────────────────────────────────────────────────── */
.data-table-wrap { overflow-x: auto; }
.data-table {
  width: 100%;
  border-collapse: collapse;
  font-family: var(--font-body);
  font-size: 13px;
}
.data-table th {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-400);
  text-align: left;
  padding: 8px 12px;
  background: var(--surface-2);
  border-bottom: 1px solid var(--hairline);
  white-space: nowrap;
}
.data-table td {
  padding: 10px 12px;
  color: var(--ink-800);
  border-bottom: 1px solid var(--hairline);
  vertical-align: top;
}
.data-table tr:last-child td { border-bottom: none; }
.data-table tr:hover td { background: var(--surface-2); }
.mono { font-family: var(--font-mono); font-size: 12px; }
.tag-pill {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 600;
  padding: 2px 6px;
  border: 1px solid var(--hairline);
  background: var(--surface-2);
  color: var(--ink-600);
  white-space: nowrap;
  margin-right: 3px;
}
.tag-pill--green  { border-color: #10b981; color: #059669; background: #f0fdf4; }
.tag-pill--red    { border-color: #f87171; color: #b91c1c; background: #fef2f2; }
.tag-pill--gold   { border-color: var(--gold-600); color: var(--gold-600); }
.tag-pill--blue   { border-color: #60a5fa; color: #1d4ed8; background: #eff6ff; }
.tag-pill--purple { border-color: #a78bfa; color: #6d28d9; background: #f5f3ff; }
.notif-active   { color: #059669; font-weight: 600; }
.notif-inactive { color: var(--ink-300); }

/* -- Member search + assignment forms -------------------------------- */
.member-search-box {
  display: flex;
  align-items: center;
}
.member-search-input {
  width: 100%;
  max-width: 480px;
  font-family: var(--font-body);
  font-size: 13px;
  padding: 9px 14px;
  border: 1px solid var(--hairline);
  background: var(--surface-0);
  color: var(--ink-900);
  outline: none;
}
.member-search-input:focus { border-color: var(--gold-600); }
.search-results-list {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--hairline);
  background: var(--surface-0);
  max-width: 480px;
  max-height: 240px;
  overflow-y: auto;
}
.search-result-item {
  padding: 10px 14px;
  cursor: pointer;
  border-bottom: 1px solid var(--hairline);
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.search-result-item:last-child { border-bottom: none; }
.search-result-item:hover { background: var(--surface-2); }
.search-result-item__name {
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 600;
  color: var(--ink-900);
}
.search-result-item__meta {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--ink-400);
}
.selected-member-card {
  display: flex;
  flex-direction: column;
  gap: 14px;
  border: 1px solid var(--hairline);
  background: var(--surface-0);
  padding: 16px 20px;
  max-width: 640px;
}
.selected-member-info {
  font-family: var(--font-body);
  font-size: 13px;
  color: var(--ink-900);
  font-weight: 600;
}
.selected-membership-info {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--ink-600);
  line-height: 1.7;
}
.assign-form-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  align-items: center;
}
.assign-form-col {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.form-label {
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink-400);
}
.recog-select {
  font-family: var(--font-body);
  font-size: 13px;
  padding: 8px 12px;
  border: 1px solid var(--hairline);
  background: var(--surface-0);
  color: var(--ink-900);
  max-width: 520px;
  outline: none;
}
.recog-select:focus { border-color: var(--gold-600); }
</style>

<script>
(function () {
  const API = '';  // same-origin — all requests go to /api/v1/...

  // ── helpers ──────────────────────────────────────────────────────────
  function show(id) { const el = document.getElementById(id); if (el) el.hidden = false; }
  function hide(id) { const el = document.getElementById(id); if (el) el.hidden = true; }
  function setText(id, txt) { const el = document.getElementById(id); if (el) el.textContent = txt; }
  function setHtml(id, html) { const el = document.getElementById(id); if (el) el.innerHTML = html; }

  function authHeaders() {
    const at = localStorage.getItem('bcc_at');
    return { 'Content-Type': 'application/json', ...(at ? { Authorization: `Bearer ${at}` } : {}) };
  }

  async function apiFetch(path, opts = {}) {
    const res = await fetch(path, { headers: authHeaders(), ...opts });
    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      throw new Error(err.message || `HTTP ${res.status}`);
    }
    return res.json();
  }

  function fmtDate(val) {
    if (!val) return '—';
    try { return new Date(val).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }); }
    catch { return val; }
  }
  function fmtDateTime(val) {
    if (!val) return '—';
    try {
      return new Date(val).toLocaleString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    } catch { return val; }
  }

  function typeBadge(type) {
    const map = {
      OPERATIONAL: 'class-badge--operational',
      CONSTITUTIONAL: 'class-badge--constitutional',
      RECOGNITION: 'class-badge--recognition',
      STATUS_OVERLAY: 'class-badge--status',
    };
    const cls = map[type] || '';
    return `<span class="class-badge ${cls}">${type}</span>`;
  }

  // ── ① DASHBOARD STATS ──────────────────────────────────────────────
  async function loadStats() {
    hide('stats-error');
    show('stats-loading');
    hide('stats-grid');
    hide('state-breakdown');
    hide('class-breakdown');
    try {
      const data = await apiFetch('/api/v1/membership/admin/stats');
      hide('stats-loading');

      const totalActive = data.byState['ACTIVE'] || 0;
      const totalPending = data.byState['PENDING'] || 0;
      const totalSuspended = data.byState['SUSPENDED'] || 0;
      const totalExpired = data.byState['EXPIRED'] || 0;
      const totalAll = Object.values(data.byState).reduce((a, b) => a + b, 0);

      const grid = document.getElementById('stats-grid');
      grid.innerHTML = `
        <div class="stat-card">
          <div class="stat-card__value">${totalAll}</div>
          <div class="stat-card__label">Total Memberships</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__value stat-card__value--gold">${totalActive}</div>
          <div class="stat-card__label">Active</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__value">${totalPending}</div>
          <div class="stat-card__label">Pending Approval</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__value stat-card__value--warn">${data.expiringIn30Days}</div>
          <div class="stat-card__label">Expiring ≤ 30 Days</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__value">${totalSuspended}</div>
          <div class="stat-card__label">Suspended</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__value">${totalExpired}</div>
          <div class="stat-card__label">Expired</div>
        </div>
      `;
      show('stats-grid');

      // State breakdown pills
      const stateEl = document.getElementById('state-breakdown');
      stateEl.innerHTML = Object.entries(data.byState)
        .sort((a, b) => b[1] - a[1])
        .map(([k, v]) => `<span class="breakdown-pill"><strong>${v}</strong> ${k}</span>`)
        .join('');
      show('state-breakdown');

      // Class breakdown pills
      const classEl = document.getElementById('class-breakdown');
      classEl.innerHTML = Object.entries(data.byClass)
        .sort((a, b) => b[1] - a[1])
        .map(([k, v]) => `<span class="breakdown-pill"><strong>${v}</strong> ${k}</span>`)
        .join('');
      show('class-breakdown');
    } catch (e) {
      hide('stats-loading');
      setText('stats-error', e.message);
      show('stats-error');
    }
  }

  // ── ② MEMBERSHIP CLASSES ───────────────────────────────────────────
  async function loadClasses() {
    hide('classes-error');
    show('classes-loading');
    hide('classes-list');
    try {
      const classes = await apiFetch('/api/v1/membership/admin/classes');
      hide('classes-loading');

      const legacyCls = classes.find(function(c) { return c.code === 'LEGACY_MEMBER'; });
      if (legacyCls) legacyClassId = legacyCls.id;

      const list = document.getElementById('classes-list');
      if (!classes.length) {
        list.innerHTML = '<p class="state-empty">No classes found.</p>';
      } else {
        list.innerHTML = classes.map(cls => {
          const closedBadge = cls.is_closed ? `<span class="class-badge class-badge--closed">Closed</span>` : '';
          const renewBadge = cls.is_renewable === false ? '' : `<span class="class-badge" style="border-color:var(--ink-300);color:var(--ink-500)">Renewable</span>`;
          const ents = cls.entitlements || {};
          const entKeys = Object.keys(ents);
          const entsHtml = entKeys.length
            ? `<div class="class-card__entitlements">` +
              entKeys.map(k => `
                <div class="entitlement-row">
                  <span class="entitlement-row__key">${k}</span>
                  <span class="entitlement-row__value">${ents[k]}</span>
                </div>`).join('') +
              `</div>`
            : `<p class="no-entitlements">No entitlements configured.</p>`;
          return `
            <div class="class-card">
              <div class="class-card__header">
                <span class="class-card__name">${cls.display_name || cls.name}</span>
                ${typeBadge(cls.type)}
                ${closedBadge}
                ${renewBadge}
              </div>
              ${entsHtml}
            </div>`;
        }).join('');
      }
      show('classes-list');
    } catch (e) {
      hide('classes-loading');
      setText('classes-error', e.message);
      show('classes-error');
    }
  }

  // legacyClassId captured when classes load — used by section ⑨
  let legacyClassId = null;

  // ── ③ SENIOR STATUS ─────────────────────────────────────────────────
  let seniorEligible = [];

  document.getElementById('btn-check-senior').addEventListener('click', async () => {
    hide('senior-error');
    hide('senior-empty');
    hide('senior-list');
    hide('senior-feedback');
    hide('btn-assign-senior');
    show('senior-loading');
    try {
      seniorEligible = await apiFetch('/api/v1/membership/admin/senior-status/eligible');
      hide('senior-loading');
      if (!seniorEligible.length) {
        show('senior-empty');
        return;
      }
      const wrap = document.getElementById('senior-list');
      wrap.innerHTML = buildSeniorTable(seniorEligible);
      show('senior-list');
      show('btn-assign-senior');
    } catch (e) {
      hide('senior-loading');
      setText('senior-error', e.message);
      show('senior-error');
    }
  });

  document.getElementById('btn-assign-senior').addEventListener('click', async () => {
    const btn = document.getElementById('btn-assign-senior');
    btn.disabled = true;
    hide('senior-feedback');
    try {
      const result = await apiFetch('/api/v1/membership/admin/senior-status/evaluate', { method: 'POST' });
      const fb = document.getElementById('senior-feedback');
      fb.textContent = `Done — ${result.assigned} Senior Member recognition(s) assigned.`;
      show('senior-feedback');
      hide('btn-assign-senior');
      hide('senior-list');
    } catch (e) {
      const fb = document.getElementById('senior-feedback');
      fb.textContent = `Error: ${e.message}`;
      show('senior-feedback');
      btn.disabled = false;
    }
  });

  function buildSeniorTable(rows) {
    const ruleLabel = { age_60_plus: 'Age ≥ 60', age_50_tenure_5: 'Age ≥ 50 + Tenure ≥ 5yr', tenure_10_years: 'Tenure ≥ 10yr' };
    return `<table class="data-table">
      <thead><tr>
        <th>Member</th>
        <th>Join Year</th>
        <th>Tenure</th>
        <th>Age</th>
        <th>Qualifying Rules</th>
      </tr></thead>
      <tbody>${rows.map(r => `<tr>
        <td>
          <div style="font-weight:600">${r.fullName || '—'}</div>
          <div class="mono" style="color:var(--ink-400)">${r.username || ''}</div>
        </td>
        <td class="mono">${r.joinYear || '—'}</td>
        <td class="mono">${r.tenureYears} yr</td>
        <td class="mono">${r.ageYears != null ? r.ageYears + ' yr' : '—'}</td>
        <td>${r.qualifyingRules.map(rule => `<span class="tag-pill tag-pill--green">${ruleLabel[rule] || rule}</span>`).join('')}</td>
      </tr>`).join('')}</tbody>
    </table>`;
  }

  // ── ④ EXPIRING SOON ─────────────────────────────────────────────────
  async function loadExpiring() {
    hide('expiring-error');
    show('expiring-loading');
    hide('expiring-list');
    hide('expiring-empty');
    try {
      const rows = await apiFetch('/api/v1/membership/admin/expiring?days=30');
      hide('expiring-loading');
      if (!rows.length) { show('expiring-empty'); return; }
      const wrap = document.getElementById('expiring-list');
      wrap.innerHTML = `<table class="data-table">
        <thead><tr>
          <th>Member</th>
          <th>Membership No.</th>
          <th>Class</th>
          <th>Expires</th>
          <th>State</th>
        </tr></thead>
        <tbody>${rows.map(r => {
          const expiresDate = new Date(r.expires_at);
          const daysLeft = Math.ceil((expiresDate - Date.now()) / 86400000);
          const urgency = daysLeft <= 7 ? 'tag-pill--red' : daysLeft <= 14 ? 'tag-pill--gold' : '';
          return `<tr>
            <td>
              <div style="font-weight:600">${r.full_name || '—'}</div>
              <div class="mono" style="color:var(--ink-400)">${r.email || r.username || ''}</div>
            </td>
            <td class="mono">${r.membership_number || '—'}</td>
            <td>${r.class_name || '—'}</td>
            <td>
              <div class="mono">${fmtDate(r.expires_at)}</div>
              <span class="tag-pill ${urgency}">${daysLeft}d</span>
            </td>
            <td><span class="tag-pill">${r.lifecycle_state}</span></td>
          </tr>`;
        }).join('')}</tbody>
      </table>`;
      show('expiring-list');
    } catch (e) {
      hide('expiring-loading');
      setText('expiring-error', e.message);
      show('expiring-error');
    }
  }

  // ── ⑤ RECENT EVENTS ────────────────────────────────────────────────
  async function loadEvents() {
    hide('events-error');
    show('events-loading');
    hide('events-list');
    hide('events-empty');
    try {
      const rows = await apiFetch('/api/v1/membership/admin/events?limit=40');
      hide('events-loading');
      if (!rows.length) { show('events-empty'); return; }
      const wrap = document.getElementById('events-list');
      wrap.innerHTML = `<table class="data-table">
        <thead><tr>
          <th>When</th>
          <th>Event</th>
          <th>Member</th>
          <th>Actor</th>
          <th>Notes</th>
        </tr></thead>
        <tbody>${rows.map(r => `<tr>
          <td class="mono" style="white-space:nowrap;font-size:11px">${fmtDateTime(r.created_at)}</td>
          <td><span class="tag-pill tag-pill--blue">${r.event_type}</span></td>
          <td>
            <div style="font-weight:600">${r.member_name || '—'}</div>
            <div class="mono" style="color:var(--ink-400)">${r.member_username || ''}</div>
          </td>
          <td class="mono" style="color:var(--ink-500)">${r.actor_name || r.actor_type || '—'}</td>
          <td style="color:var(--ink-500);font-size:12px;max-width:240px">${r.notes || '—'}</td>
        </tr>`).join('')}</tbody>
      </table>`;
      show('events-list');
    } catch (e) {
      hide('events-loading');
      setText('events-error', e.message);
      show('events-error');
    }
  }

  // ── ⑥ NOTIFICATION TYPES ───────────────────────────────────────────
  async function loadNotifTypes() {
    hide('notifs-error');
    show('notifs-loading');
    hide('notifs-list');
    hide('notifs-empty');
    try {
      const rows = await apiFetch('/api/v1/membership/admin/notification-types');
      hide('notifs-loading');
      if (!rows.length) { show('notifs-empty'); return; }
      const wrap = document.getElementById('notifs-list');
      wrap.innerHTML = `<table class="data-table">
        <thead><tr>
          <th>Type Key</th>
          <th>Module</th>
          <th>Description</th>
          <th>Channels</th>
          <th>Active</th>
        </tr></thead>
        <tbody>${rows.map(r => `<tr>
          <td class="mono" style="white-space:nowrap">${r.type_key}</td>
          <td><span class="tag-pill">${r.module}</span></td>
          <td style="font-size:12px;color:var(--ink-600)">${r.description || '—'}</td>
          <td>${(r.channels || '').split(',').map(c => `<span class="tag-pill tag-pill--purple">${c.trim()}</span>`).join('')}</td>
          <td class="${r.is_active ? 'notif-active' : 'notif-inactive'}">${r.is_active ? 'Yes' : 'No'}</td>
        </tr>`).join('')}</tbody>
      </table>`;
      show('notifs-list');
    } catch (e) {
      hide('notifs-loading');
      setText('notifs-error', e.message);
      show('notifs-error');
    }
  }

  // ── 7: RENEWAL REMINDERS ─────────────────────────────────────────
  document.getElementById('btn-send-reminders').addEventListener('click', async function() {
    var btn = document.getElementById('btn-send-reminders');
    btn.disabled = true;
    hide('reminders-error');
    hide('reminders-feedback');
    show('reminders-loading');
    try {
      var result = await apiFetch('/api/v1/membership/admin/renewal-reminders', { method: 'POST' });
      hide('reminders-loading');
      var fb = document.getElementById('reminders-feedback');
      fb.innerHTML =
        'Reminders dispatched: ' +
        '<strong>' + (result.sent30 || 0) + '</strong> at 30d &nbsp; ' +
        '<strong>' + (result.sent15 || 0) + '</strong> at 15d &nbsp; ' +
        '<strong>' + (result.sent7  || 0) + '</strong> at 7d &nbsp; ' +
        '<strong>' + (result.sent1  || 0) + '</strong> at 1d';
      show('reminders-feedback');
    } catch (e) {
      hide('reminders-loading');
      setText('reminders-error', e.message);
      show('reminders-error');
    } finally {
      btn.disabled = false;
    }
  });

  // ── 8: EXPIRY PROCESSING ─────────────────────────────────────────
  var dueForExpiry = [];

  document.getElementById('btn-load-due').addEventListener('click', async function() {
    hide('expiry-error');
    hide('expiry-empty');
    hide('expiry-list');
    hide('expiry-feedback');
    hide('btn-process-expiry');
    show('expiry-loading');
    try {
      dueForExpiry = await apiFetch('/api/v1/membership/admin/expire-due');
      hide('expiry-loading');
      if (!dueForExpiry.length) { show('expiry-empty'); return; }
      var wrap = document.getElementById('expiry-list');
      wrap.innerHTML = '<table class="data-table">' +
        '<thead><tr>' +
          '<th>Member</th><th>Membership No.</th><th>Class</th><th>Expired</th>' +
        '</tr></thead>' +
        '<tbody>' + dueForExpiry.map(function(r) {
          return '<tr>' +
            '<td><div style="font-weight:600">' + (r.full_name || r.display_name || r.username || '') + '</div>' +
            '<div class="mono" style="color:var(--ink-400)">' + (r.username || '') + '</div></td>' +
            '<td class="mono">' + (r.membership_number || r.temp_number || '—') + '</td>' +
            '<td>' + (r.class_name || r.class_code || '—') + '</td>' +
            '<td class="mono">' + fmtDate(r.expires_at) + '</td>' +
          '</tr>';
        }).join('') + '</tbody></table>';
      show('expiry-list');
      show('btn-process-expiry');
    } catch (e) {
      hide('expiry-loading');
      setText('expiry-error', e.message);
      show('expiry-error');
    }
  });

  document.getElementById('btn-process-expiry').addEventListener('click', async function() {
    var btn = document.getElementById('btn-process-expiry');
    btn.disabled = true;
    hide('expiry-feedback');
    hide('expiry-error');
    try {
      var result = await apiFetch('/api/v1/membership/admin/process-expiry', { method: 'POST' });
      hide('expiry-list');
      var fb = document.getElementById('expiry-feedback');
      var ok = (result.results || []).filter(function(r) { return r.status === 'expired'; }).length;
      var errs = (result.results || []).filter(function(r) { return r.status === 'error'; }).length;
      fb.textContent = 'Processed ' + result.processed + ' membership(s): ' + ok + ' expired' + (errs ? ', ' + errs + ' error(s).' : '.');
      show('expiry-feedback');
      hide('btn-process-expiry');
    } catch (e) {
      setText('expiry-error', e.message);
      show('expiry-error');
      btn.disabled = false;
    }
  });

  // ── 9 & 10: MEMBER SEARCH helper ─────────────────────────────────
  function debounce(fn, ms) {
    var timer;
    return function() {
      var args = arguments;
      clearTimeout(timer);
      timer = setTimeout(function() { fn.apply(null, args); }, ms);
    };
  }

  function buildMemberSearchHandler(inputId, resultsId, onSelect) {
    var input = document.getElementById(inputId);
    var results = document.getElementById(resultsId);

    input.addEventListener('input', debounce(async function() {
      var q = input.value.trim();
      if (q.length < 2) { results.hidden = true; results.innerHTML = ''; return; }
      try {
        var rows = await apiFetch('/api/v1/users/admin/search?q=' + encodeURIComponent(q));
        if (!rows.length) { results.hidden = true; return; }
        results.innerHTML = rows.map(function(u) {
          return '<div class="search-result-item" data-user-id="' + u.id + '">' +
            '<span class="search-result-item__name">' + (u.display_name || u.username) + '</span>' +
            '<span class="search-result-item__meta">' + u.username + ' &middot; ' + (u.email || '') + '</span>' +
          '</div>';
        }).join('');
        results.hidden = false;
        results.querySelectorAll('.search-result-item').forEach(function(item) {
          item.addEventListener('click', function() {
            var userId = parseInt(item.getAttribute('data-user-id'), 10);
            results.hidden = true;
            input.value = item.querySelector('.search-result-item__name').textContent;
            onSelect(userId, item);
          });
        });
      } catch (e) {
        results.hidden = true;
      }
    }, 350));

    document.addEventListener('click', function(e) {
      if (!results.contains(e.target) && e.target !== input) results.hidden = true;
    });
  }

  async function loadMemberMemberships(userId) {
    return apiFetch('/api/v1/membership/admin/users/' + userId + '/memberships');
  }

  function activeMembership(memberships) {
    return (memberships || []).find(function(m) { return m.lifecycle_state === 'ACTIVE'; }) || null;
  }

  function membershipInfoHtml(m) {
    if (!m) return '<span style="color:var(--input-error,#b91c1c)">No ACTIVE membership found for this member.</span>';
    return [
      'Membership #: <strong>' + (m.membership_number || m.temp_membership_number || '—') + '</strong>',
      'Class: <strong>' + (m.class_name || m.class_code || '—') + '</strong>',
      'State: <strong>' + m.lifecycle_state + '</strong>',
      m.expires_at ? 'Expires: <strong>' + fmtDate(m.expires_at) + '</strong>' : '',
    ].filter(Boolean).join(' &nbsp;&nbsp; ');
  }

  // ── 9: LEGACY STATUS ASSIGNMENT ──────────────────────────────────
  var legacySelectedMembershipId = null;

  buildMemberSearchHandler('legacy-search-input', 'legacy-search-results', async function(userId) {
    hide('legacy-error');
    hide('legacy-feedback');
    legacySelectedMembershipId = null;
    try {
      var memberships = await loadMemberMemberships(userId);
      var active = activeMembership(memberships);
      legacySelectedMembershipId = active ? Number(active.id) : null;

      setHtml('legacy-member-info', 'Selected member — user ID ' + userId);
      setHtml('legacy-membership-info', membershipInfoHtml(active));
      document.getElementById('btn-assign-legacy').disabled = !active;
      show('legacy-member-card');
    } catch (e) {
      setText('legacy-error', 'Could not load memberships: ' + e.message);
      show('legacy-error');
    }
  });

  document.getElementById('btn-assign-legacy').addEventListener('click', async function() {
    if (!legacySelectedMembershipId) return;
    if (!legacyClassId) {
      setText('legacy-error', 'LEGACY_MEMBER class not loaded yet — reload the page and try again.');
      show('legacy-error');
      return;
    }
    var btn = document.getElementById('btn-assign-legacy');
    btn.disabled = true;
    hide('legacy-error');
    hide('legacy-feedback');
    var reason = document.getElementById('legacy-reason').value.trim() || 'Legacy status assignment via admin console';
    try {
      await apiFetch('/api/v1/membership/' + legacySelectedMembershipId + '/upgrade', {
        method: 'POST',
        body: JSON.stringify({ newClassId: legacyClassId, reason: reason }),
      });
      var fb = document.getElementById('legacy-feedback');
      fb.textContent = 'Legacy status assigned successfully.';
      show('legacy-feedback');
      hide('legacy-member-card');
      legacySelectedMembershipId = null;
      document.getElementById('legacy-search-input').value = '';
    } catch (e) {
      setText('legacy-error', 'Assignment failed: ' + e.message);
      show('legacy-error');
      btn.disabled = false;
    }
  });

  // ── 10: HONORARY RECOGNITION ASSIGNMENT ──────────────────────────
  var recogSelectedMembershipId = null;

  buildMemberSearchHandler('recog-search-input', 'recog-search-results', async function(userId) {
    hide('recog-error');
    hide('recog-feedback');
    recogSelectedMembershipId = null;
    try {
      var memberships = await loadMemberMemberships(userId);
      var active = activeMembership(memberships);
      recogSelectedMembershipId = active ? Number(active.id) : null;

      setHtml('recog-member-info', 'Selected member — user ID ' + userId);
      setHtml('recog-membership-info', membershipInfoHtml(active));
      document.getElementById('btn-assign-recog').disabled = !active;
      show('recog-member-card');
    } catch (e) {
      setText('recog-error', 'Could not load memberships: ' + e.message);
      show('recog-error');
    }
  });

  document.getElementById('btn-assign-recog').addEventListener('click', async function() {
    if (!recogSelectedMembershipId) return;
    var btn = document.getElementById('btn-assign-recog');
    btn.disabled = true;
    hide('recog-error');
    hide('recog-feedback');
    var recognitionCode = document.getElementById('recog-code-select').value;
    var reason = document.getElementById('recog-reason').value.trim() || 'Honorary recognition assignment via admin console';
    try {
      await apiFetch('/api/v1/membership/recognitions/' + recogSelectedMembershipId + '/assign', {
        method: 'POST',
        body: JSON.stringify({ recognitionCode: recognitionCode, track: 'MANUAL', reason: reason }),
      });
      var fb = document.getElementById('recog-feedback');
      fb.textContent = recognitionCode + ' assigned successfully.';
      show('recog-feedback');
      hide('recog-member-card');
      recogSelectedMembershipId = null;
      document.getElementById('recog-search-input').value = '';
      document.getElementById('recog-reason').value = '';
    } catch (e) {
      setText('recog-error', 'Assignment failed: ' + e.message);
      show('recog-error');
      btn.disabled = false;
    }
  });

  // ── Bootstrap ─────────────────────────────────────────────────────
  loadStats();
  loadClasses();
  loadExpiring();
  loadEvents();
  loadNotifTypes();
})();
</script>
