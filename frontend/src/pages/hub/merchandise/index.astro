---
// frontend/src/pages/hub/merchandise/index.astro
//
// Merchandise V1 — bare minimal customer page (authorizing prompt §13).
// Deliberately NOT a full storefront: no search, categories, wishlists,
// or shipping UI. Products are fetched from the public
// GET /api/v1/merchandise/products endpoint (no hardcoded prices/content).
//
// Checkout reuses the existing, unmodified PAY-001 Razorpay Checkout
// pattern from MembershipApplicationFlow.astro: the browser is never
// authoritative for price or payment success (authorizing prompt §14/§15).
import HubLayout from '../../../layouts/HubLayout.astro';
---

<HubLayout title="Merchandise" description="BCC Branded Merchandise — pickup only.">
  <div class="hub-main" id="merch-root">
    <header class="page-header">
      <div class="section-kicker"><span class="kicker-rule"></span>MEMBER HUB — MERCHANDISE</div>
      <h1 class="page-title">BCC Branded Merchandise</h1>
      <p class="page-subtitle">Pickup only — no shipping. Prices and any discount are confirmed by the server before payment.</p>
    </header>

    <section id="merch-products" aria-label="Products"></section>

    <section id="merch-order-form" class="merch-card">
      <h2 class="merch-h2">Your Order</h2>
      <div id="merch-order-lines"></div>

      <label class="merch-field">
        <span>Coupon code (optional)</span>
        <input type="text" id="merch-coupon" placeholder="Enter coupon code" autocomplete="off" />
      </label>

      <div id="merch-error" class="merch-error" hidden></div>

      <button id="merch-place-order" class="btn-gold" type="button">Place Order</button>
    </section>

    <section id="merch-summary" class="merch-card" hidden>
      <h2 class="merch-h2">Order Summary</h2>
      <dl class="merch-summary-list">
        <dt>Subtotal</dt><dd id="merch-subtotal"></dd>
        <dt>Discount</dt><dd id="merch-discount"></dd>
        <dt>Total Payable</dt><dd id="merch-total"></dd>
      </dl>
      <p class="merch-note">Fulfilment: pickup only — you'll be notified when your order is ready.</p>
      <div id="merch-payment-error" class="merch-error" hidden></div>
      <button id="merch-pay-btn" class="btn-gold" type="button">Pay Now</button>
      <p id="merch-payment-status" class="merch-note" hidden></p>
    </section>
  </div>

  <style>
    .merch-card { background: #FFFFFF; border: 1px solid rgba(20,18,16,0.08); padding: 24px; margin-top: 24px; max-width: 560px; }
    .merch-h2 { font-family: Outfit, sans-serif; font-size: 1.1rem; margin: 0 0 16px; }
    .merch-product { display: flex; justify-content: space-between; align-items: center; padding: 14px 0; border-bottom: 1px solid rgba(20,18,16,0.08); }
    .merch-product:last-child { border-bottom: none; }
    .merch-product-name { font-weight: 600; }
    .merch-product-price { font-family: 'JetBrains Mono', monospace; color: #A8843C; }
    .merch-qty { width: 60px; padding: 6px; margin-left: 12px; }
    .merch-field { display: block; margin: 16px 0; }
    .merch-field input { width: 100%; padding: 10px; margin-top: 6px; border: 1px solid rgba(20,18,16,0.15); }
    .merch-error { color: #B3261E; margin: 12px 0; }
    .merch-summary-list { display: grid; grid-template-columns: 1fr auto; gap: 6px 16px; font-family: 'JetBrains Mono', monospace; }
    .merch-note { color: #6B6660; font-size: 0.9rem; margin-top: 12px; }
  </style>

  <script>
    declare const Razorpay: any;

    (function () {
      const API = '/api/v1';
      function token(): string | null { return localStorage.getItem('bcc_token'); }

      const productsEl = document.getElementById('merch-products') as HTMLElement;
      const orderLinesEl = document.getElementById('merch-order-lines') as HTMLElement;
      const couponInput = document.getElementById('merch-coupon') as HTMLInputElement;
      const errorEl = document.getElementById('merch-error') as HTMLElement;
      const placeOrderBtn = document.getElementById('merch-place-order') as HTMLButtonElement;
      const summarySection = document.getElementById('merch-summary') as HTMLElement;
      const subtotalEl = document.getElementById('merch-subtotal') as HTMLElement;
      const discountEl = document.getElementById('merch-discount') as HTMLElement;
      const totalEl = document.getElementById('merch-total') as HTMLElement;
      const payBtn = document.getElementById('merch-pay-btn') as HTMLButtonElement;
      const paymentErrorEl = document.getElementById('merch-payment-error') as HTMLElement;
      const paymentStatusEl = document.getElementById('merch-payment-status') as HTMLElement;

      let products: Array<{ id: number; name: string; pricePaise: number }> = [];
      let currentOrder: { id: number; financialContributionId: number | null; totalPaise: number } | null = null;

      function formatRupees(paise: number): string {
        return `₹${(paise / 100).toFixed(2)}`;
      }

      function showError(message: string) {
        errorEl.textContent = message;
        errorEl.hidden = false;
      }
      function clearError() {
        errorEl.hidden = true;
        errorEl.textContent = '';
      }

      async function loadProducts() {
        const res = await fetch(`${API}/merchandise/products`);
        if (!res.ok) { showError('Could not load products.'); return; }
        products = await res.json();
        productsEl.innerHTML = products
          .map(
            (p) => `
          <div class="merch-product" data-product-id="${p.id}">
            <div>
              <div class="merch-product-name">${p.name}</div>
              <div class="merch-product-price">${formatRupees(p.pricePaise)}</div>
            </div>
            <input type="number" class="merch-qty" min="0" value="0" data-product-id="${p.id}" aria-label="Quantity for ${p.name}" />
          </div>`,
          )
          .join('');
      }

      function collectItems(): Array<{ productId: number; quantity: number }> {
        const inputs = productsEl.querySelectorAll<HTMLInputElement>('.merch-qty');
        const items: Array<{ productId: number; quantity: number }> = [];
        inputs.forEach((input) => {
          const qty = parseInt(input.value, 10);
          if (qty > 0) items.push({ productId: Number(input.dataset.productId), quantity: qty });
        });
        return items;
      }

      async function placeOrder() {
        clearError();
        const items = collectItems();
        if (items.length === 0) { showError('Select at least one product.'); return; }

        placeOrderBtn.disabled = true;
        try {
          const res = await fetch(`${API}/merchandise/orders`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token() ?? ''}` },
            body: JSON.stringify({ items, couponCode: couponInput.value.trim() || undefined }),
          });
          if (res.status === 401) { window.location.replace('/auth/signin/?next=/hub/merchandise/'); return; }
          const body = await res.json();
          if (!res.ok) { showError(body?.message ?? 'Could not place order.'); return; }

          currentOrder = { id: body.id, financialContributionId: body.financialContributionId, totalPaise: body.totalPaise };
          subtotalEl.textContent = formatRupees(body.subtotalPaise);
          discountEl.textContent = formatRupees(body.discountPaise);
          totalEl.textContent = formatRupees(body.totalPaise);
          summarySection.hidden = false;
          summarySection.scrollIntoView({ behavior: 'smooth' });
        } catch {
          showError('Network error placing order. Please try again.');
        } finally {
          placeOrderBtn.disabled = false;
        }
      }

      function loadRazorpayScript(): Promise<void> {
        if (typeof Razorpay !== 'undefined') return Promise.resolve();
        const existing = document.getElementById('merch-razorpay-sdk');
        if (existing) {
          return new Promise((resolve, reject) => {
            existing.addEventListener('load', () => resolve());
            existing.addEventListener('error', () => reject(new Error('razorpay-sdk-load-failed')));
          });
        }
        return new Promise((resolve, reject) => {
          const script = document.createElement('script');
          script.id = 'merch-razorpay-sdk';
          script.src = 'https://checkout.razorpay.com/v1/checkout.js';
          script.onload = () => resolve();
          script.onerror = () => reject(new Error('razorpay-sdk-load-failed'));
          document.head.appendChild(script);
        });
      }

      // ARCHITECTURAL RULE (same as MembershipApplicationFlow.astro): the
      // browser is never authoritative for payment success. Checkout's own
      // success handler only means "Checkout reports success" -- this polls
      // the backend's Financial Contribution status until the signed
      // Razorpay webhook has resolved it server-side. No order state is
      // ever set from this script.
      async function pollContributionUntilResolved(contributionId: number): Promise<string> {
        for (let attempt = 0; attempt < 10; attempt++) {
          const res = await fetch(`${API}/financial/contributions/${contributionId}`, {
            headers: { Authorization: `Bearer ${token() ?? ''}` },
          });
          if (res.ok) {
            const body = await res.json();
            if (body.state !== 'SETTLEMENT_IN_PROGRESS') return body.state;
          }
          await new Promise((r) => setTimeout(r, 3000));
        }
        return 'UNKNOWN';
      }

      async function beginCheckout() {
        if (!currentOrder?.financialContributionId) return;
        paymentErrorEl.hidden = true;
        payBtn.disabled = true;

        try {
          const orderRes = await fetch(
            `${API}/financial/contributions/${currentOrder.financialContributionId}/settlement/razorpay-order`,
            { method: 'POST', headers: { Authorization: `Bearer ${token() ?? ''}` } },
          );
          if (!orderRes.ok) throw new Error('order-failed');
          const order = await orderRes.json();
          if (!order.providerPublicKeyId) throw new Error('order-failed');

          await loadRazorpayScript();

          const rzp = new Razorpay({
            key: order.providerPublicKeyId,
            order_id: order.orderReference,
            amount: order.amountPaise,
            currency: order.currency,
            name: 'Bhopal Camera Club',
            description: 'BCC Merchandise Order',
            handler: async () => {
              paymentStatusEl.hidden = false;
              paymentStatusEl.textContent = 'Verifying payment...';
              const state = await pollContributionUntilResolved(currentOrder!.financialContributionId!);
              if (state === 'COMPLETED') {
                paymentStatusEl.textContent = 'Payment confirmed. Your order is being prepared for pickup.';
                payBtn.hidden = true;
              } else {
                paymentStatusEl.textContent = 'We could not confirm payment yet. Refresh this page to check again.';
              }
            },
            modal: { ondismiss: () => { payBtn.disabled = false; } },
          });
          rzp.open();
        } catch {
          paymentErrorEl.hidden = false;
          paymentErrorEl.textContent = 'Could not start payment. Please try again.';
        } finally {
          payBtn.disabled = false;
        }
      }

      placeOrderBtn.addEventListener('click', placeOrder);
      payBtn.addEventListener('click', beginCheckout);
      loadProducts();
    })();
  </script>
</HubLayout>
