---
/**
 * membership.astro — V6 15 Membership · Route /membership
 *
 * Design Authority: ProjectDocs/Wireframes/V6/15 Join/V6 15 Join.dc.html
 *
 * MEM-006 ABSOLUTE PUBLIC DOMAIN POLICY:
 * Only Basic · Student · Individual · Family · Corporate are shown.
 * Full / Life / Patron / Founding NEVER appear anywhere on this page.
 *
 * MEM-006 Three distinct CTAs:
 * - "Become a Member" → /auth/register/ (conversion)
 * - "Sign In" → /auth/signin/ (returning users, in nav)
 * - "Apply for Membership" → separate step from Member Hub (post-registration)
 *
 * Active members (ACTIVE/APPROVED lifecycle) are redirected to /hub.
 *
 * Page Sections (7):
 * 01 Hero — "Belong Here." dark split, community photo
 * 02 Community in Action — editorial justified photo grid
 * 03 Why Become a Member — 5 benefit pillars
 * 04 Choose Your Membership — 4 identity cards (2×2)
 * 05 Membership Comparison — row-per-tier, expand on click
 * 06 Frequently Asked Questions — one-at-a-time accordion
 * 07 Become a Member — dark CTA band
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import CTASection from '../components/ui/CTASection.astro';
import CommunityPhotoGrid from '../components/join/CommunityPhotoGrid.astro';
import BenefitPillarGrid from '../components/join/BenefitPillarGrid.astro';
import IdentityCardGrid from '../components/join/IdentityCardGrid.astro';
import MembershipComparisonBlock from '../components/join/MembershipComparisonBlock.astro';
import FAQAccordion from '../components/join/FAQAccordion.astro';
import {
  BENEFIT_PILLARS,
  IDENTITY_CARDS,
  PUBLIC_TIERS,
  JOIN_FAQS,
  COMMUNITY_ROW_1,
  COMMUNITY_ROW_2,
} from '../lib/join-page.config';

// Live pricing/term override. Individual-ownership tiers (Basic/Student/
// Individual Annual/Individual Biennial) are priced from
// class_entitlements.fee_inr; Family/Corporate are group memberships priced
// from group_type_entitlements.fee_inr (see membership.controller.ts
// publicClasses(), which merges both sources by classCode). PUBLIC_TIERS
// carries editorial copy (who/eligibility/benefits) plus a fallback price
// for build-time-unavailable backend; the fetch below overrides annual/
// period for all six public tiers whenever the backend is reachable,
// matching CLAUDE.md §4.5 build-time fetch convention.
const liveTiers = [...PUBLIC_TIERS];
try {
  const res = await fetch('http://localhost:3001/api/v1/membership/public/classes');
  if (res.ok) {
    const classes = await res.json() as Array<{
      code: string;
      feeInr: number;
      validityMonths: number;
    }>;
    for (const cls of classes) {
      const idx = liveTiers.findIndex((t) => t.classCode === cls.code);
      if (idx === -1) continue;
      const formattedFee = `₹${cls.feeInr.toLocaleString('en-IN')}`;
      liveTiers[idx] = {
        ...liveTiers[idx],
        annual: formattedFee,
        period: cls.validityMonths > 12 ? `for ${Math.round(cls.validityMonths / 12)} years` : 'per year',
      };
    }
  }
} catch {
  // Backend unavailable at build time -- tiers keep their PUBLIC_TIERS fallback pricing.
}
---

<BaseLayout
  title="Membership — Bhopal Camera Club"
  description="Join the Bhopal Camera Club photography community. Memberships for students, individuals, families, and organisations. Photography is richer when shared."
>

  <!-- §01 Hero — "Belong Here." dark split layout -->
  <PageHero
    variant="join"
    eyebrow="Bhopal Camera Club · Membership"
    title={`Belong\nHere.`}
    subtitle="Photography is richer when shared. A community of photographers across Bhopal — learning, creating, and growing together since 2016."
    joinPrimaryText="Explore Memberships"
    joinPrimaryHref="#choose-membership"
    joinSecondaryText="See Membership Options"
    joinSecondaryHref="#compare"
  />

  <!-- §02 Community in Action -->
  <section class="join-section join-section--white" aria-label="A Community in Action">
    <div class="join-container">
      <div class="join-section-intro">
        <div class="join-eyebrow-row">
          <span class="join-eyebrow-line" aria-hidden="true"></span>
          <span class="join-eyebrow">A Community in Action</span>
        </div>
        <h2 class="join-section-heading">This is what we do together.</h2>
        <p class="join-section-body">From early-morning photowalks to year-end exhibitions — BCC members share every step of the photographic journey.</p>
      </div>
    </div>
    <div class="join-photo-grid-wrap">
      <CommunityPhotoGrid row1={COMMUNITY_ROW_1 as any} row2={COMMUNITY_ROW_2 as any} />
    </div>
  </section>

  <!-- §03 Why Become a Member -->
  <section class="join-section join-section--parchment" aria-label="Why Become a Member" id="why-join">
    <div class="join-container">
      <div class="join-section-intro">
        <div class="join-eyebrow-row">
          <span class="join-eyebrow-line" aria-hidden="true"></span>
          <span class="join-eyebrow">Why Become a Member</span>
        </div>
        <h2 class="join-section-heading join-section-heading--narrow">Photography finds its full meaning in community.</h2>
        <p class="join-section-body">Membership is not a transaction. It is a decision to invest in the craft — and in the people who share it.</p>
      </div>
      <BenefitPillarGrid pillars={BENEFIT_PILLARS} />
    </div>
  </section>

  <!-- §04 Choose Your Membership -->
  <section class="join-section join-section--white" aria-label="Choose Your Membership" id="choose-membership">
    <div class="join-container">
      <div class="join-section-intro">
        <div class="join-eyebrow-row">
          <span class="join-eyebrow-line" aria-hidden="true"></span>
          <span class="join-eyebrow">Choose Your Membership</span>
        </div>
        <h2 class="join-section-heading">Which best describes you?</h2>
        <p class="join-section-body join-section-body--narrow">Select the description that fits — we'll point you to the right membership.</p>
      </div>
      <IdentityCardGrid cards={IDENTITY_CARDS as any} />
      <!-- Basic entry-point note -->
      <div class="join-basic-note">
        <div class="join-basic-note__text">
          <strong>Just getting started?</strong> Basic membership is always available as your entry point to the BCC community.
        </div>
        <a href="#tier-basic" class="join-basic-note__link">See Basic Membership →</a>
      </div>
    </div>
  </section>

  <!-- §05 Membership Comparison -->
  <section class="join-section join-section--ivory" aria-label="Membership Comparison" id="compare">
    <div class="join-container">
      <div class="join-section-intro">
        <div class="join-eyebrow-row">
          <span class="join-eyebrow-line" aria-hidden="true"></span>
          <span class="join-eyebrow">Membership Comparison</span>
        </div>
        <h2 class="join-section-heading">Find the right membership.</h2>
        <p class="join-section-body join-section-body--narrow">Six memberships. One right one for you. Select a row to see the details.</p>
      </div>
      <MembershipComparisonBlock tiers={liveTiers} />
    </div>
  </section>

  <!-- §06 Frequently Asked Questions -->
  <section class="join-section join-section--white" aria-label="Frequently Asked Questions" id="faq">
    <div class="join-container">
      <div class="join-section-intro">
        <div class="join-eyebrow-row">
          <span class="join-eyebrow-line" aria-hidden="true"></span>
          <span class="join-eyebrow">Frequently Asked Questions</span>
        </div>
        <h2 class="join-section-heading">Questions we hear most often.</h2>
      </div>
      <div class="join-faq-wrap">
        <FAQAccordion questions={JOIN_FAQS} />
      </div>
    </div>
  </section>

  <!-- §07 Become a Member — final CTA (one gold CTA, constitution §3.3) -->
  <CTASection
    eyebrow="Bhopal Camera Club · /membership"
    heading="Ready to become a member?"
    body="Photography is richer when shared. The BCC community is waiting."
    ariaLabel="Become a Member"
  >
    <div class="join-final-ctas">
      <a href="/auth/register" class="join-cta-gold">Become a Member</a>
      <a href="/auth/signin/" class="join-cta-ghost">Sign in if you already have an account</a>
    </div>
  </CTASection>

</BaseLayout>

<style>
/* ── Page-level layout tokens ──────────────────────────────────── */
.join-container {
  max-width: 1140px;
  margin: 0 auto;
  padding: 0 48px;
}
.join-photo-grid-wrap {
  max-width: 1140px;
  margin: 0 auto;
  padding: 0 48px 64px;
}

/* ── Sections ──────────────────────────────────────────────────── */
.join-section {
  padding: 80px 0;
}
.join-section--white    { background: var(--surface-0); }
.join-section--parchment { background: var(--surface-2); }
.join-section--ivory    { background: var(--surface-1); }

/* ── Section intro block ───────────────────────────────────────── */
.join-section-intro {
  margin-bottom: 48px;
}

.join-eyebrow-row {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 10px;
}
.join-eyebrow-line {
  display: block;
  width: 28px;
  height: 1px;
  background: var(--gold-600);
  flex-shrink: 0;
}
.join-eyebrow {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--gold-600);
  text-transform: uppercase;
  letter-spacing: 0.18em;
  font-weight: 500;
}

.join-section-heading {
  font-family: var(--font-display);
  font-size: clamp(28px, 3vw, 36px);
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--ink-900);
  line-height: 1.15;
  margin-bottom: 12px;
  max-width: 600px;
}
.join-section-heading--narrow { max-width: 540px; }

.join-section-body {
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.75;
  color: var(--ink-600);
  font-weight: 300;
  max-width: 560px;
  margin-bottom: 0;
}
.join-section-body--narrow { max-width: 520px; }

/* ── Basic note (§04 footer) ─────────────────────────────────── */
.join-basic-note {
  margin-top: 24px;
  border: 1px solid var(--hairline-soft);
  background: var(--surface-1);
  padding: 18px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}
.join-basic-note__text {
  font-size: 13px;
  color: var(--ink-600);
  line-height: 1.6;
}
.join-basic-note__text strong {
  color: var(--ink-900);
  font-weight: 600;
}
.join-basic-note__link {
  font-size: 13px;
  color: var(--gold-600);
  text-decoration: none;
  white-space: nowrap;
  font-weight: 500;
  flex-shrink: 0;
}
.join-basic-note__link:hover {
  text-decoration: underline;
}

/* ── FAQ container ────────────────────────────────────────────── */
.join-faq-wrap {
  max-width: 800px;
}

/* ── Final CTAs (§07) ─────────────────────────────────────────── */
.join-final-ctas {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
  margin-top: var(--s-5, 40px);
}
.join-cta-gold {
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.04em;
  background: var(--gold-gradient);
  color: #FFFFFF;
  padding: 18px 48px;
  border-radius: 2px;
  text-decoration: none;
  box-shadow: var(--gold-gradient-glow);
  transition: opacity 0.2s ease;
}
.join-cta-gold:hover { opacity: 0.9; color: #FFFFFF; }

.join-cta-ghost {
  font-size: 13px;
  font-weight: 500;
  color: #C8C0B8;
  padding: 18px 28px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 2px;
  background: rgba(255, 255, 255, 0.04);
  text-decoration: none;
  transition: background 0.2s ease;
}
.join-cta-ghost:hover { background: rgba(255, 255, 255, 0.08); color: #FAF8F4; }

/* ── Responsive ──────────────────────────────────────────────── */
@media (max-width: 900px) {
  .join-container {
    padding: 0 40px;
  }
  .join-photo-grid-wrap {
    padding: 0 40px 48px;
  }
  .join-section {
    padding: 64px 0;
  }
  .join-section-intro {
    margin-bottom: 40px;
  }
}

@media (max-width: 480px) {
  .join-container {
    padding: 0 20px;
  }
  .join-photo-grid-wrap {
    padding: 0 20px 40px;
  }
  .join-section {
    padding: 48px 0;
  }
  .join-final-ctas {
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }
  .join-cta-gold,
  .join-cta-ghost {
    width: 100%;
    text-align: center;
    display: block;
  }
  .join-basic-note {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
}
</style>

<script>
  import { loadJoinHero } from '../lib/hero-loader';

  /* §01 Hero — loads via canonical 'membership' destination */
  loadJoinHero();

  /* §02 Community in Action — load each editorial photo from its canonical destination.
   * Cells carry data-destination attributes set at build time by CommunityPhotoGrid.
   * Each cell's placeholder is replaced by the assigned editorial photo when available. */
  document.querySelectorAll<HTMLElement>('.cpg__cell[data-destination]').forEach(cell => {
    const dest = cell.getAttribute('data-destination');
    if (!dest) return;
    fetch(`/api/v1/gallery/hero/location/${encodeURIComponent(dest)}`)
      .then(r => r.ok ? r.json() : null)
      .then(photo => {
        if (!photo?.urls) return;
        const url = photo.urls.original || photo.urls.medium || '';
        if (!url) return;
        const placeholder = cell.querySelector('.cpg__placeholder');
        const img = document.createElement('img');
        img.className = 'cpg__img';
        img.loading = 'lazy';
        img.decoding = 'async';
        img.alt = photo.title || cell.querySelector('.cpg__caption-label')?.textContent || '';
        img.src = url;
        img.addEventListener('load', () => { placeholder?.remove(); }, { once: true });
        if (placeholder) {
          cell.insertBefore(img, placeholder);
        } else {
          cell.prepend(img);
        }
      })
      .catch(() => { /* placeholder remains */ });
  });

  /* Smooth scroll for anchor links */
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(link => {
    link.addEventListener('click', e => {
      const id = link.getAttribute('href')?.slice(1);
      const target = id ? document.getElementById(id) : null;
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  /* Membership state routing — reconciled with the Membership Engine lifecycle.
   *
   * Engine lifecycle states (MEM-006 seven-state machine):
   *   PENDING    → application submitted, under review
   *   APPROVED   → approved, awaiting activation / payment
   *   ACTIVE     → fully active member
   *   SUSPENDED  → suspended by admin (membership exists; hub manages this)
   *   EXPIRED    → membership term lapsed; renewal required
   *   TERMINATED → membership terminated (can reapply from scratch)
   *   REJECTED   → application rejected (can reapply)
   *
   * Routing decisions:
   *   Guest (no token)              → show membership page  ✓
   *   Registered, no memberships    → show membership page  ✓
   *   PENDING                       → /hub/membership/ (track application)
   *   APPROVED                      → /hub/           (activate membership)
   *   ACTIVE                        → /hub/           (already a member)
   *   SUSPENDED                     → /hub/           (admin-managed, hub surfaced)
   *   EXPIRED                       → /hub/membership/ (renew, not re-join)
   *   TERMINATED | REJECTED         → show membership page  (may reapply)
   */
  (async () => {
    try {
      const token = localStorage.getItem('bcc_token');
      if (!token) return;

      const res = await fetch('/api/v1/membership/mine', {
        headers: { Authorization: `Bearer ${token}` },
      });
      if (!res.ok) return;

      const memberships: Array<{ lifecycle_state: string }> = await res.json();
      if (!Array.isArray(memberships) || memberships.length === 0) return;

      /* Priority order: prefer the most "active" state when multiple records exist */
      const REDIRECT_TO_HUB = new Set(['ACTIVE', 'APPROVED', 'SUSPENDED']);
      const REDIRECT_TO_MEMBERSHIP = new Set(['PENDING', 'EXPIRED']);
      const priority = ['ACTIVE', 'APPROVED', 'SUSPENDED', 'PENDING', 'EXPIRED'];

      const dominant = priority
        .map(s => memberships.find(m => m.lifecycle_state === s))
        .find(Boolean);

      if (!dominant) return; /* TERMINATED / REJECTED — show membership page */

      if (REDIRECT_TO_HUB.has(dominant.lifecycle_state)) {
        window.location.replace('/hub/');
      } else if (REDIRECT_TO_MEMBERSHIP.has(dominant.lifecycle_state)) {
        window.location.replace('/hub/membership/');
      }
    } catch (_) { /* non-blocking */ }
  })();
</script>
